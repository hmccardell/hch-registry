# Copy to server/.env for local development:  cp .env.example .env
# In production (Render) set these in the dashboard instead — see render.yaml
# and the "Deploy to Render" section of the README.

# Local dev port. Render provides its own PORT and ignores this.
PORT=4000

# Set to "production" on the deployed server. When it's set, the server refuses
# to start unless REGISTRY_AUTH_SECRET and SMTP_URL are provided. Leave unset
# locally.
# NODE_ENV=production

# Subpath the registry is served from, on the main HCH site. Every route (API,
# health, static bundle) is mounted under it. Leave as default unless the
# reverse proxy uses a different path; if you change it, also change `base` in
# frontend/vite.config.js to match (it's baked in at build time).
# BASE_PATH=/registry

# Absolute, browser-facing URL of the registry, used to build the sign-in link
# in the email. Required in production (behind a proxy the Host header can't be
# trusted). Locally, leave unset — the link is derived from the request origin.
# PUBLIC_URL=https://hubcityhackers.com/registry

# --- Sign-in ---
# Members sign in with an emailed one-time link; there is no password.
# Access = being a row in the members table (matched on `email`).

# Signs the emailed magic-link tokens and the Bearer session tokens. Required in
# production; changing it invalidates outstanding links and logs everyone out.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# (The Render blueprint generates this for you.)
REGISTRY_AUTH_SECRET=

# Optional token lifetimes (milliseconds). Defaults: link 15 min, session 12 h.
# MAGIC_LINK_TTL_MS=900000
# SESSION_TTL_MS=43200000

# Transactional email as one SMTP URL — any provider (Resend, Postmark, SES...):
#   smtps://apikey:re_xxx@smtp.resend.com:465
# Required in production. Unset locally: sign-in links print to the server
# console instead of being sent.
SMTP_URL=
MAIL_FROM=HCH Registry <no-reply@hubcityhackers.com>

# --- Supabase: the project holding the members table ---
# Supabase dashboard -> Project Settings -> Data API -> Project URL
SUPABASE_URL=
# Supabase dashboard -> Project Settings -> API Keys -> service_role (secret).
# Server-only, bypasses row-level security. Never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Table name, only set this if you didn't call it "members".
# SUPABASE_MEMBERS_TABLE=members
