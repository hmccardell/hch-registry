# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# The Google Sheet that the Member Registry Form writes responses to.
# Share this sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL (Viewer) before this will work.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Form Responses 1

# Service account credentials (Google Cloud Console > IAM > Service Accounts).
# Enable the Google Sheets API on the project, create a key, share the sheet with the
# service account's email, then paste the values below.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep this on one line; literal \n between the BEGIN/END markers is expected.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
