# Copy to server/.env for local development:  cp .env.example .env
# In production (Render) set these in the dashboard instead — see render.yaml
# and the "Deploy to Render" section of the README.

# Local dev port. Render provides its own PORT and ignores this.
PORT=4000

# Set to "production" on the deployed server. When it's set, the server refuses
# to start unless AUTH_PASSWORD and AUTH_SECRET are provided. Leave unset locally.
# NODE_ENV=production

# --- Registry access gate (one shared credential, checked server-side) ---
AUTH_USER=hch
# Required in production. Choose a strong passphrase.
AUTH_PASSWORD=
# Required in production. Signs session tokens; changing it logs everyone out.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# (The Render blueprint generates this for you.)
AUTH_SECRET=

# --- Google Sheet: the response sheet behind the registry form ---
# Share the sheet with GOOGLE_SERVICE_ACCOUNT_EMAIL as Viewer first, or every
# /api/directory call 500s.
GOOGLE_SHEET_ID=
# The response tab's name, exactly (case-sensitive). Google's default:
GOOGLE_SHEET_RANGE=Form Responses 1
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The private_key from the service-account JSON, pasted as-is. Real newlines or
# literal \n both work; keep the BEGIN/END lines.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
